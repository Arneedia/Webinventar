{
  "name": "webinventar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build",
    "start": "next start",
    "start:prod": "node -r dotenv/config node_modules/.bin/next start dotenv_config_path=.env.local",
    "studio": "prisma studio --port 5555 --browser none",
    "lint": "eslint",
    "seed": "tsx prisma/seed.ts",
    "db:setup-postgres": "tsx scripts/setup-postgres-schema.ts",
    "db:migrate-to-vercel": "tsx scripts/migrate-to-vercel.ts",
    "postinstall": "node scripts/prisma-generate.js"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@prisma/adapter-better-sqlite3": "^7.1.0",
    "@prisma/adapter-libsql": "^7.1.0",
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.0.1",
    "@prisma/extension-accelerate": "^3.0.1",
    "better-sqlite3": "^12.5.0",
    "dotenv": "^17.2.3",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.555.0",
    "mssql": "^12.2.0",
    "next": "^16.0.7",
    "next-pwa": "^5.6.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "swr": "^2.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/minimatch": "^6.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.6",
    "prisma": "^7.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
