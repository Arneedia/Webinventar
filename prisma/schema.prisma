// Prisma Schema fÃ¼r die lokale Inventar-Datenbank

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Abteilungen
model ABT {
  ABTID    Int        @id @default(autoincrement())
  ABTName  String?
  Benutzer Benutzer[]
  AufgabenAssigned UebergabeAufgabe[] @relation("AufgabeAssignedAbteilung")
}

// Status
model STAT {
  StatusID   Int        @id @default(autoincrement())
  StatusName String?
  Benutzer   Benutzer[]
}

// GeschÃ¤ftsstellen
model GS {
  GSID      Int        @id @default(autoincrement())
  GSName    String?
  GSStrasse String?
  GSHausNr  String?
  GSPLZ     String?
  GSOrt     String?
  Benutzer  Benutzer[]
  Raeume    RAUM[]
}

// Hardware-Typen
model HW {
  HWID     Int      @id @default(autoincrement())
  HWName   String?
  HWCode   String   @unique
  GER      GER[]
  HW_HS    HW_HS[]
  HS_MOD   HS_MOD[]
  Zubehoer Zubehoer[]
}

// Hersteller
model HS {
  HSID     Int      @id @default(autoincrement())
  HSName   String?
  GER      GER[]
  HW_HS    HW_HS[]
  HS_MOD   HS_MOD[]
  Zubehoer Zubehoer[]
}

// Modelle
model MOD {
  ModID        Int      @id @default(autoincrement())
  ModName      String?
  ModellNummer String?
  GER          GER[]
  HS_MOD       HS_MOD[]
  Zubehoer     Zubehoer[]
}

// Benutzer
model Benutzer {
  BenutzerID       Int               @id @default(autoincrement())
  BenutzerName     String?
  BenutzerRaum     String?
  RaumID           Int?
  ABTID            Int?
  StatusID         Int?
  GSID             Int?
  ABT              ABT?              @relation(fields: [ABTID], references: [ABTID])
  STAT             STAT?             @relation(fields: [StatusID], references: [StatusID])
  GS               GS?               @relation(fields: [GSID], references: [GSID])
  RAUM             RAUM?             @relation("BenutzerRaum", fields: [RaumID], references: [RaumID])
  BenutzerGER        BenutzerGER[]
  ZubehoerBenutzer   ZubehoerBenutzer[]
  ZubehoerBewegung   ZubehoerBewegung[]
  UebergabeProtokolle UebergabeProtokoll[]
  AufgabenAssigned    UebergabeAufgabe[] @relation("AufgabeAssignedBenutzer")
  BueroInventar      BueroInventar[]
  BueroBewegungVon   BueroBewegung[] @relation("BueroBewegungVon")
  BueroBewegungNach  BueroBewegung[] @relation("BueroBewegungNach")
}

// RÃ¤ume (Stammdaten fÃ¼r GerÃ¤te-Standorte)
model RAUM {
  RaumID         Int        @id @default(autoincrement())
  RaumName       String?
  Standort       String?
  Notiz          String?
  GSID           Int?
  GS             GS?        @relation(fields: [GSID], references: [GSID])
  Benutzer       Benutzer[] @relation("BenutzerRaum")
  GeraeteStandard GER[]     @relation("GeraetStandardRaum")
  RaumGefahrenstellen RaumGefahrenstelle[]
  BueroInventar   BueroInventar[]
}

// GerÃ¤te
model GER {
  GerID          Int      @id @default(autoincrement())
  HWID           Int
  HSID           Int
  MODID          Int
  StandardRaumID Int?
  SNO            String?
  InventarCode   String   @unique
  WODISNr        String?  @unique
  Preis          Decimal?
  Zugang         DateTime
  Abgang         DateTime?
  EAN            String?
  IMEI1          String?
  IMEI2          String?
  HW             HW            @relation(fields: [HWID], references: [HWID])
  HS             HS            @relation(fields: [HSID], references: [HSID])
  MOD            MOD           @relation(fields: [MODID], references: [ModID])
  StandardRaum         RAUM?              @relation("GeraetStandardRaum", fields: [StandardRaumID], references: [RaumID])
  BenutzerGER          BenutzerGER[]
  ZubehoerBenutzer     ZubehoerBenutzer[]
  ZubehoerBewegung     ZubehoerBewegung[]
  UebergabePositionen  UebergabePosition[]
}

// Benutzer-GerÃ¤te Zuordnung
model BenutzerGER {
  ID         Int       @id @default(autoincrement())
  BenutzerID Int
  GERID      Int
  Start      DateTime
  Ende       DateTime?
  Benutzer   Benutzer  @relation(fields: [BenutzerID], references: [BenutzerID])
  GER        GER       @relation(fields: [GERID], references: [GerID])
}

// ZubehÃ¶r-Typen
model ZT {
  ID               Int                @id @default(autoincrement())
  ZTName           String
  Zubehoer         Zubehoer[]
  ZubehoerInventar ZubehoerInventar[]
}

// ZubehÃ¶r
model Zubehoer {
  ZubehoerID        Int                @id @default(autoincrement())
  ZTID              Int
  HWID              Int?
  ModID             Int?
  HSID              Int?
  Beschreibung      String?
  ZT                ZT                 @relation(fields: [ZTID], references: [ID])
  HW                HW?                @relation(fields: [HWID], references: [HWID])
  MOD               MOD?               @relation(fields: [ModID], references: [ModID])
  HS                HS?                @relation(fields: [HSID], references: [HSID])
  ZubehoerBenutzer  ZubehoerBenutzer[]
  ZubehoerBewegung  ZubehoerBewegung[]
  UebergabePositionen UebergabePosition[]

  @@map("ZubehÃ¶r")
}

// ZubehÃ¶r-Benutzer Zuordnung
model ZubehoerBenutzer {
  ID         Int       @id @default(autoincrement())
  BenutzerID Int?
  ZubehoerID Int
  GerID      Int?
  Start      DateTime
  Ende       DateTime?
  Benutzer   Benutzer? @relation(fields: [BenutzerID], references: [BenutzerID])
  Zubehoer   Zubehoer  @relation(fields: [ZubehoerID], references: [ZubehoerID])
  GER        GER?      @relation(fields: [GerID], references: [GerID])

  @@map("ZubehÃ¶rBenutzer")
}

// ZubehÃ¶r-Inventar
model ZubehoerInventar {
  InventarID Int       @id @default(autoincrement())
  ZTID       Int
  Menge      Int
  Zugang     DateTime
  Abgang     DateTime?
  ZT         ZT        @relation(fields: [ZTID], references: [ID])

  @@map("ZubehÃ¶rInventar")
}

// ZubehÃ¶r-Bewegungen (Tracking)
model ZubehoerBewegung {
  ID          Int       @id @default(autoincrement())
  ZubehoerID  Int
  Typ         String    // ZUGANG, ABGANG, ZUWEISUNG_GERAET, RUECKGABE_GERAET, ZUWEISUNG_BENUTZER, RUECKGABE_BENUTZER, DEFEKT
  Menge       Int       @default(1)
  GerID       Int?
  BenutzerID  Int?
  Bemerkung   String?
  Zeitpunkt   DateTime  @default(now())
  Zubehoer    Zubehoer  @relation(fields: [ZubehoerID], references: [ZubehoerID])
  GER         GER?      @relation(fields: [GerID], references: [GerID])
  Benutzer    Benutzer? @relation(fields: [BenutzerID], references: [BenutzerID])

  @@map("ZubehÃ¶rBewegung")
}

// Hardware-Hersteller Zuordnung
model HW_HS {
  HWID Int
  HSID Int
  HW   HW @relation(fields: [HWID], references: [HWID])
  HS   HS @relation(fields: [HSID], references: [HSID])

  @@id([HWID, HSID])
}

// Hersteller-Modell Zuordnung
model HS_MOD {
  HSID  Int
  ModID Int
  HWID  Int?
  HS    HS   @relation(fields: [HSID], references: [HSID])
  MOD   MOD  @relation(fields: [ModID], references: [ModID])
  HW    HW?  @relation(fields: [HWID], references: [HWID])

  @@id([HSID, ModID])
}

// Web-User fÃ¼r Login/Autorisierung
model WebUser {
  id                 Int                       @id @default(autoincrement())
  email              String                    @unique
  name               String?
  passwordHash       String
  role               String                    @default("USER")
  mustChangePassword Boolean                   @default(false)
  sessions           Session[]
  permissionGroups   WebUserPermissionGroup[]
  erstellteProtokolle UebergabeProtokoll[]
  reportsCreated      Report[]                  @relation("ReportCreator")
  reportExportsCreated ReportExport[]           @relation("ReportExportCreator")
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
}

// Rechtegruppen fÃ¼r granulare Berechtigungen
model PermissionGroup {
  id          Int                       @id @default(autoincrement())
  name        String                    @unique
  description String?
  permissions String                    // JSON-Array mit Berechtigungen
  users       WebUserPermissionGroup[]
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
}

// Many-to-Many Zuordnung WebUser <-> PermissionGroup
model WebUserPermissionGroup {
  id                Int             @id @default(autoincrement())
  userId            Int
  permissionGroupId Int
  user              WebUser         @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionGroup   PermissionGroup @relation(fields: [permissionGroupId], references: [id], onDelete: Cascade)
  assignedAt        DateTime        @default(now())

  @@unique([userId, permissionGroupId])
}

model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      WebUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// Ãœbergabeprotokolle fÃ¼r GerÃ¤te-Ausgabe und -RÃ¼cknahme
model UebergabeProtokoll {
  ID              Int       @id @default(autoincrement())
  ProtokollNr     String    @unique  // z.B. "UP-2024-00042"
  Typ             String    // AUSGABE, RUECKGABE, TAUSCH
  BenutzerID      Int
  ErstelltAm      DateTime  @default(now())
  ErstelltVon     Int       // WebUser ID (IT-Mitarbeiter)
  
  // Unterschriften (Base64 Signatur-Bild)
  UnterschriftMitarbeiter   String?   @db.Text
  UnterschriftIT            String?   @db.Text
  UnterschriftDatum         DateTime?
  
  // Status: ENTWURF, OFFEN, UNTERSCHRIEBEN, ARCHIVIERT
  Status          String    @default("ENTWURF")
  
  // Optionale Felder
  Bemerkung       String?   @db.Text
  
  // Relationen
  Benutzer        Benutzer  @relation(fields: [BenutzerID], references: [BenutzerID])
  Ersteller       WebUser   @relation(fields: [ErstelltVon], references: [id])
  Positionen      UebergabePosition[]
  Aufgaben        UebergabeAufgabe[]
}

// Einzelne Positionen im Protokoll (GerÃ¤te + ZubehÃ¶r)
model UebergabePosition {
  ID              Int       @id @default(autoincrement())
  ProtokollID     Int
  
  // Entweder GerÃ¤t ODER ZubehÃ¶r (eines von beiden muss gesetzt sein)
  GerID           Int?
  ZubehoerID      Int?
  
  // Zustand bei Ãœbergabe: NEU, GUT, GEBRAUCHSSPUREN, BESCHAEDIGT
  Zustand         String    @default("GUT")
  ZustandNotiz    String?
  
  // Bei RÃ¼ckgabe: VollstÃ¤ndigkeit
  Vollstaendig    Boolean   @default(true)
  FehlendTeile    String?   // z.B. "Ladekabel fehlt"
  
  Protokoll       UebergabeProtokoll @relation(fields: [ProtokollID], references: [ID], onDelete: Cascade)
  GER             GER?      @relation(fields: [GerID], references: [GerID])
  Zubehoer        Zubehoer? @relation(fields: [ZubehoerID], references: [ZubehoerID])
}

model UebergabeAufgabe {
  ID           Int                @id @default(autoincrement())
  ProtokollID  Int
  Titel        String
  Beschreibung String?
  FaelligAm    DateTime?
  Status       String             @default("OFFEN") // OFFEN, ERLEDIGT
  ErstelltAm   DateTime           @default(now())
  ErledigtAm   DateTime?
  AssignedBenutzerID  Int?
  AssignedAbteilungID Int?

  Protokoll    UebergabeProtokoll @relation(fields: [ProtokollID], references: [ID])
  AssignedBenutzer  Benutzer? @relation("AufgabeAssignedBenutzer", fields: [AssignedBenutzerID], references: [BenutzerID])
  AssignedAbteilung ABT?      @relation("AufgabeAssignedAbteilung", fields: [AssignedAbteilungID], references: [ABTID])
}

model UebergabeAufgabeVorlage {
  ID             Int      @id @default(autoincrement())
  Typ            String   // AUSGABE (Onboarding), RUECKGABE (Offboarding), optional TAUSCH
  Titel          String
  Beschreibung   String?
  FaelligInTagen Int?
  Sortierung     Int      @default(0)
  Aktiv          Boolean  @default(true)
  ErstelltAm     DateTime @default(now())
  AktualisiertAm DateTime @updatedAt

  @@index([Typ, Sortierung])
}

model Report {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  definition  Json
  createdBy   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator     WebUser   @relation("ReportCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  exports     ReportExport[]
}

model ReportExport {
  id        Int      @id @default(autoincrement())
  reportId  Int
  format    String
  createdBy Int
  createdAt DateTime @default(now())

  report   Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  creator  WebUser @relation("ReportExportCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([reportId, createdAt])
}

// Gefahrenstellen (Hazard Locations)
model Gefahrenstelle {
  GefahrenstelleID   Int      @id @default(autoincrement())
  Name               String
  Beschreibung       String?
  RaumGefahrenstellen RaumGefahrenstelle[]
}

// Junction Table: Raum <-> Gefahrenstelle (Many-to-Many)
model RaumGefahrenstelle {
  ID               Int      @id @default(autoincrement())
  RaumID           Int
  GefahrenstelleID Int
  Notiz            String?
  
  Raum             RAUM             @relation(fields: [RaumID], references: [RaumID], onDelete: Cascade)
  Gefahrenstelle   Gefahrenstelle   @relation(fields: [GefahrenstelleID], references: [GefahrenstelleID], onDelete: Cascade)

  @@unique([RaumID, GefahrenstelleID])
}

// Büroinventar-Kategorien
model BueroKategorie {
  ID           Int            @id @default(autoincrement())
  Name         String         @unique
  Beschreibung String?
  Inventar     BueroInventar[]
}

// Büroinventar
model BueroInventar {
  ID              Int              @id @default(autoincrement())
  KategorieID     Int
  Bezeichnung     String
  Beschreibung    String?
  InventarNr      String?          @unique
  Seriennummer    String?
  Hersteller      String?
  Modell          String?
  Anschaffungsdatum DateTime?
  Anschaffungspreis Decimal?
  Zustand         String?
  RaumID          Int?
  BenutzerID      Int?
  Notiz           String?
  Kategorie       BueroKategorie   @relation(fields: [KategorieID], references: [ID])
  Raum            RAUM?            @relation(fields: [RaumID], references: [RaumID])
  Benutzer        Benutzer?        @relation(fields: [BenutzerID], references: [BenutzerID])
  Bewegungen      BueroBewegung[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

// Büroinventar-Bewegungen (Tracking)
model BueroBewegung {
  ID              Int            @id @default(autoincrement())
  InventarID      Int
  Typ             String
  VonBenutzerID   Int?
  NachBenutzerID  Int?
  VonRaumID       Int?
  NachRaumID      Int?
  Bemerkung       String?
  Zeitpunkt       DateTime       @default(now())
  Inventar        BueroInventar  @relation(fields: [InventarID], references: [ID])
  VonBenutzer     Benutzer?      @relation("BueroBewegungVon", fields: [VonBenutzerID], references: [BenutzerID])
  NachBenutzer    Benutzer?      @relation("BueroBewegungNach", fields: [NachBenutzerID], references: [BenutzerID])
}

